{
    "$comment": "Floors and anchors for the generated datasets. A degraded parse of a hand-maintained C++ table almost always yields FEWER rows or drops a column, so these guard the failure mode that a diff review would rationalize away. Raise the floors deliberately when an upstream bump genuinely adds entries; never lower one to make a build pass.",
    "uids": {
        "minCount": 450,
        "requiredKeywords": [
            "Verification",
            "ImplicitVRLittleEndian",
            "ExplicitVRLittleEndian",
            "ExplicitVRBigEndian",
            "DeflatedExplicitVRLittleEndian",
            "JPEGBaseline8Bit",
            "JPEG2000Lossless",
            "RLELossless",
            "CTImageStorage",
            "MRImageStorage",
            "UltrasoundImageStorage",
            "ComputedRadiographyImageStorage",
            "SecondaryCaptureImageStorage",
            "BasicTextSRStorage",
            "EnhancedSRStorage",
            "Comprehensive3DSRStorage",
            "EncapsulatedPDFStorage",
            "SegmentationStorage",
            "RTPlanStorage",
            "GrayscaleSoftcopyPresentationStateStorage",
            "TwelveLeadECGWaveformStorage",
            "PatientRootQueryRetrieveInformationModelFind",
            "StudyRootQueryRetrieveInformationModelMove",
            "ModalityWorklistInformationModelFind",
            "StorageCommitmentPushModel",
            "DICOMApplicationContext"
        ]
    },
    "attributes": {
        "minCount": 5300,
        "minAmbiguousVr": 20,
        "requiredKeywords": [
            "SpecificCharacterSet",
            "PatientName",
            "PatientID",
            "StudyInstanceUID",
            "SeriesInstanceUID",
            "SOPInstanceUID",
            "SOPClassUID",
            "TransferSyntaxUID",
            "PixelData",
            "PixelRepresentation",
            "BitsAllocated",
            "Rows",
            "Columns",
            "NumberOfFrames",
            "ImagePositionPatient",
            "ImageOrientationPatient",
            "WindowCenter",
            "LUTData",
            "OverlayRows",
            "ExtendedOffsetTable",
            "PrivateCreator"
        ],
        "$comment-requiredRanges": "Repeating groups must survive as ranges. A build that flattens them to a single representative tag still passes every count check, so the notation itself is asserted.",
        "requiredRanges": ["(6000-60FF,0010)", "(6000-60FF,3000)", "(0028,04X0)", "(1000,XXX0)", "(0009-o-FFFF,0010-u-00FF)"]
    },
    "privateTags": {
        "minCount": 2800,
        "minCreators": 120,
        "$comment": "A creator string is the join key for every private lookup. If the quoted column stops parsing, the row count barely moves but the creator count collapses.",
        "requiredCreators": ["SIEMENS MEDCOM HEADER", "GEMS_IDEN_01", "Philips Imaging DD 001", "AGFA", "ACUSON"]
    },
    "deidentification": {
        "minCount": 600,
        "requiredOptions": [
            "cleanDescriptors",
            "cleanStructuredContent",
            "retainLongitudinalFullDates",
            "retainLongitudinalModifiedDates",
            "retainUids",
            "retainPatientCharacteristics",
            "retainDeviceIdentity",
            "retainInstitutionIdentity",
            "cleanGraphics",
            "retainSafePrivate"
        ]
    },
    "transferSyntaxes": {
        "minCount": 50,
        "requiredUids": [
            "1.2.840.10008.1.2",
            "1.2.840.10008.1.2.1",
            "1.2.840.10008.1.2.1.99",
            "1.2.840.10008.1.2.2",
            "1.2.840.10008.1.2.5",
            "1.2.840.10008.1.2.4.50",
            "1.2.840.10008.1.2.4.51",
            "1.2.840.10008.1.2.4.57",
            "1.2.840.10008.1.2.4.70",
            "1.2.840.10008.1.2.4.80",
            "1.2.840.10008.1.2.4.90",
            "1.2.840.10008.1.2.4.91"
        ]
    }
}
